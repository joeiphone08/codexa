# Generate a secure secret with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

PORT=3000

# REQUIRED: Replace with a long random string before first run
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# Directory to store books, covers, fonts, and the SQLite database
DATA_DIR=./data

# REQUIRED on any public deployment (Railway, a VPS, anything reachable from the internet).
# Several protections fail *open* without it, because they are deliberately relaxed for local
# LAN/dev use: the BookOrbit SSRF guard below, and the refusal to accept CORS_ORIGIN=*.
# The bundled Dockerfile already sets this; set it explicitly if you deploy any other way.
NODE_ENV=production

# Optional: restrict CORS to your domain (leave blank to allow same-origin only).
# Comma-separated list of exact origins, e.g. https://books.example.com,https://www.example.com
# "*" is REJECTED at startup when NODE_ENV=production — it would let any website on the internet
# read this API's responses cross-origin. Blank (same-origin only) is the right value for a
# normal single-domain deployment.
CORS_ORIGIN=

# Optional: pin self-service registration open ('true') or closed ('false') from the deployment
# config. Leave unset to keep using the in-app admin toggle only.
# Worth setting to 'false' on a public deploy once you have created your own account: registration
# is open by default, and the FIRST account created on a fresh instance becomes the admin — so on
# a freshly-deployed public URL, whoever signs up first owns the instance.
# REGISTRATION_ENABLED=false

# Optional: allow BookOrbit/KOReader sync to reach private, loopback and link-local addresses
# (10.x, 192.168.x, 127.0.0.1, 169.254.169.254, fc00::/7, ...). Those are blocked when
# NODE_ENV=production, because the BookOrbit server URL is a per-user setting and an unrestricted
# one turns this server into a proxy into its own private network / cloud metadata service.
# Set to 'true' ONLY if Codexa and BookOrbit both run on the same trusted private network.
# BOOKORBIT_ALLOW_PRIVATE_NETWORK=false

# Set to true to enable verbose console logging in the browser (default: false)
DEBUG=false

# Optional: OIDC login (Google, Apple, or a self-hosted provider like Dex/Authelia/Keycloak).
# Leave OIDC_PROVIDERS blank/unset to disable — no "Sign in with..." buttons will appear.
# See README for the full setup guide, including a self-hosted Dex example with predefined users.
#
# OIDC_PROVIDERS=google,dex
# OIDC_BASE_URL=https://books.example.com
#
# OIDC_GOOGLE_ISSUER=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# OIDC_GOOGLE_NAME=Google
#
# OIDC_DEX_ISSUER=https://auth.example.com/dex
# OIDC_DEX_CLIENT_ID=
# OIDC_DEX_CLIENT_SECRET=
# OIDC_DEX_NAME=Home SSO
